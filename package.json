{
  "name": "astra-3d-benchmark",
  "version": "0.1.0",
  "private": true,
  "description": "A reproducible, evidence-backed study of an Astra-assisted 3D content workflow.",
  "scripts": {
    "dev": "vite",
    "build": "npm run research:validate && npm run research:build && tsc -b && vite build",
    "build:app": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:scripts && npm run test:render-plan",
    "test:unit": "vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:render-plan": "node --test research/runs/2026-10-20-sol-material-ab-render/*.test.mjs research/runs/2026-10-21-sol-geometry-baseline/*.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test",
    "render:compare": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright node research/runs/2026-10-20-sol-material-ab-render/capture.mjs",
    "render:repair-closeups": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright node research/runs/2026-10-20-sol-material-ab-render/capture.mjs --repair-closeups",
    "render:refresh-metrics": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright node research/runs/2026-10-20-sol-material-ab-render/capture.mjs --metrics-only",
    "research:build": "node scripts/build-study-data.mjs",
    "research:validate": "node scripts/validate-research.mjs",
    "asset:fetch": "node scripts/fetch-asset.mjs primary-product",
    "asset:sanitize": "node scripts/sanitize-model.mjs research/assets/upstream/CarConcept.glb public/assets/models/product.glb 'License Plate' 'InteriorSteeringEmblem'",
    "asset:inspect": "gltf-transform inspect public/assets/models/product.glb",
    "asset:inspect-integrated": "gltf-transform inspect public/assets/models/product-estuary.glb"
  },
  "keywords": [
    "astra",
    "3d",
    "benchmark",
    "three.js"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "jsdom": "^30.1.3",
    "meshoptimizer": "1.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
