{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astra-3d-benchmark",
  "compatibility_date": "2026-10-01",
  // Served only on the custom domain: no *.workers.dev URL, no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "astra.daedalwerks.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist"
  }
}
